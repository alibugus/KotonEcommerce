@model EcommerceProject.Models.ShopViewModel

<div class="row">
    @foreach (var product in Model.Products)
    {
        <div class="col-lg-4 col-md-6 col-sm-6" data-product-id="@product.Id">
            <div class="product__item @(product.StockQuantity > 0 ? "" : "out-of-stock")">
                <div class="product__item__pic set-bg" data-setbg="@product.ImageUrl">
                    @if (product.StockQuantity <= 0)
                    {
                        <span class="label">Out of Stock</span>
                    }
                    <ul class="product__hover">
                        <li>
                            <a href="#" onclick="AddToWishList(@product.Id); return false;">
                                <img class="wishlist-icon" src="img/icon/heart.png" alt="Add to Wishlist">
                            </a>
                        </li>
                       
                    </ul>
                </div>
                <div class="product__item__text">
                    <h6>@product.Name</h6>
                    <a href="" class="add-cart" onclick="AddToCart(@product.Id); return false;">+ Add To Cart</a>
                    <div class="rating">
                        @for (int i = 0; i < 5; i++)
                        {
                            <i class="fa @(i < 4 ? "fa-star" : "fa-star-o")"></i>
                        }
                    </div>
                    <h5>@product.Price.ToString("C")</h5>

                    <!-- Dynamic Size Selection -->
                    <div class="product__size__select">
                        @foreach (var size in product.ProductSizes)
                        {
                            <label class="size-label" for="size-@size.Id">
                                <input type="radio" name="size-@product.Id" id="size-@size.Id" value="@size.Size" @(size.StockQuantity > 0 ? "" : "disabled")>
                                @size.Size
                            </label>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div id="feedback" style="margin-top: 20px;"></div>

<!-- Login/Register Modal -->
<div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0" style="border-radius: 10px;">
            <div class="modal-header border-0">
                <h5 class="modal-title" id="loginModalLabel">Login or Register</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="background-color: #f8f9fa;">
                <p class="text-center mb-4">Please log in or register to proceed with your checkout.</p>
                <div class="d-flex justify-content-around">
                    <a href="@Url.Action("Index", "Login")" class="btn btn-dark text-white">Login</a>
                    <a href="@Url.Action("Index", "Register")" class="btn btn-outline-dark">Register</a>
                </div>
                <div class="text-center mt-3">
                    <button type="button" class="btn btn-outline-secondary" onclick="kapat()" id="continueAsGuestBtn">Continue as Guest </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        // Ürün resmi tıklanınca işlem başlatılır
        $('.product__item__pic').on('click', function () {
            // closest ile en yakın div[data-product-id] olan elemanı bul
            var productId = $(this).closest('div[data-product-id]').data('product-id');
            console.log("Product ID (closest):", productId);

            // Alternatif olarak, doğrudan parent div'den productId çek
            var directProductId = $(this).parent().data('product-id');
            console.log("Product ID (direct):", directProductId);

            // Ürün detayları için AJAX isteği
            window.location.href = '@Url.Action("IndexGet", "ProductDetails")?ProductId=' + productId;
          
        });
    });
    $(document).ready(function () {
        setTimeout(function () {
            $('.product__item').each(function () {
                var productId = $(this).closest('div[data-product-id]').data('product-id');
                console.log("Product ID:", productId);
                checkIfProductInWishList(productId, $(this));
            });
        }, 100);
    });
    function kapat() {
        var myModalEl = document.getElementById('loginModal');
        var myModal = bootstrap.Modal.getInstance(myModalEl);
        if (myModal) {
            myModal.hide();
        } else {
            var myModal = new bootstrap.Modal(myModalEl);
            myModal.hide();
        }
    }

    $(document).ready(function () {
        // Ürün resmine tıklanınca yönlendirme işlemi
        $('.product__item__pic').on('click', function (event) {
            // Ürün resmi tıklanırken, en yakın üst div'den data-product-id değerini al
            var productId = $(this).closest('div[data-product-id]').data('product-id');
            console.log("Product ID:", productId);

            // Ürün detayları için yönlendirme
            window.location.href = '@Url.Action("IndexGet", "ProductDetails")?ProductId=' + productId;
        });

        // Wishlist butonlarına tıklanma kontrolü
        $('.wishlist-icon').on('click', function (event) {
            // Wishlist butonuna tıklanırken yönlendirme işlemi engelle
            event.stopPropagation();
            var productId = $(this).closest('div[data-product-id]').data('product-id');
            AddToWishList(productId);
        });

    });

    function AddToCart(productId) {
        // Capture the selected size value
        var selectedSize = $('input[name="size-' + productId + '"]:checked').val();

        if (!selectedSize) {
            alert("Please select a size before adding to cart.");
            return;
        }

        console.log("AddToCart called with productId:", productId, "size:", selectedSize);
        $.ajax({
            url: '@Url.Action("AddToCart", "ShopCart")',  // Adjust URL as needed
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ ProductId: productId, selectedSize: selectedSize, Quantity: 1 }),
            success: function (response) {
                if (response.success) {
                    $('#feedback').html('<div class="alert alert-success">' + response.message + '</div>');
                    updateCartDetails();
                    window.location.reload();
                   
                } else {
                    $('#feedback').html('<div class="alert alert-danger">' + response.message + '</div>');
                }
            },
            error: function (xhr, status, error) {
                $('#feedback').html('<div class="alert alert-danger">An error occurred: ' + error + '</div>');
            }
        });
    }

    function checkIfProductInWishList(productId, productElement) {
        $.ajax({
            url: '@Url.Action("IsProductInWishList", "WishList")',
            type: 'POST',
            dataType: 'json',
            data: { productId: productId },
            success: function (response) {
                if (response.inWishList) {
                    console.log("check " + productId);
                    productElement.find('.wishlist-icon').attr('src', 'img/icon/heart-filled.png');
                } else {
                    console.log("checkme " + productId);
                    productElement.find('.wishlist-icon').attr('src', 'img/icon/heart.png');
                }
            },
            error: function (xhr, status, error) {
                console.log('Error:', error);
            }
        });
    }

    function AddToWishList(productId) {
        event.preventDefault();
        var isAuthenticated = '@User.Identity.IsAuthenticated';
        if (isAuthenticated === 'False') {
            var myModal = new bootstrap.Modal(document.getElementById('loginModal'));
            myModal.show();
            return;
        }

        $.ajax({
            url: '@Url.Action("ToggleWishList", "WishList")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ ProductId: productId }),
            success: function (response) {
                if (response.success) {
                    $('#feedback').html('<div class="alert alert-success">' + response.message + '</div>');
                    var iconSrc = response.inWishList ? 'img/icon/heart-filled.png' : 'img/icon/heart.png';
                    $('div[data-product-id="' + productId + '"] .wishlist-icon').attr('src', iconSrc);
                } else {
                    $('#feedback').html('<div class="alert alert-danger">' + response.message + '</div>');
                }
            },
            error: function (xhr, status, error) {
                $('#feedback').html('<div class="alert alert-danger">An error occurred: ' + error + '</div>');
            }
        });
    }

    // Handle size selection
    var selectedSize = '';
    $('.product__size__select input[type="radio"]').on('change', function () {
        selectedSize = $(this).val();
    });
</script>

